---
import { commentConfig } from "../../config";
import GiscusComment from "./GiscusComment.astro";
import BackendComment from "./BackendComment.svelte";

interface Props {
  slug: string;
}

const { slug } = Astro.props;

const hasGiscus = commentConfig.giscus?.repo && commentConfig.giscus?.repoId;
const hasBackend = commentConfig.backend?.enabled && commentConfig.backend?.serverUrl;
---

<div class="comment-section w-full">
  {hasGiscus && (
    <div class="giscus-section card-base p-6 rounded-[var(--radius-large)] mb-4">
      <GiscusComment />
    </div>
  )}

  {hasBackend && (
    <div class="backend-section card-base p-6 rounded-[var(--radius-large)] mb-4">
      <BackendComment client:visible postSlug={slug} serverUrl={commentConfig.backend!.serverUrl} />
    </div>
  )}

  {!hasGiscus && !hasBackend && (
    <div class="text-center py-4 text-black/30 dark:text-white/30 text-sm">
      评论功能未配置
    </div>
  )}
</div>
